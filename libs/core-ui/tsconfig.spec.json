{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "lib": ["dom", "dom.iterable", "es6"],
    "paths": {
      "@shadcn-ui": ["../shadcn-ui/src/index.ts"],
      "@shadcn-ui/*": ["../shadcn-ui/src/*"],
      "@fs/intl": ["../shared/intl/src/index.ts"]
    }
  },
  "include": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    "../../libs/shadcn-ui/src/**/*"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../shared/intl"
    },
    {
      "path": "../../libs/shadcn-ui"
    }
  ]
}
